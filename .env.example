# Copy this file to .env and fill in your keys
# The app reads these at server startup

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Ollama runs locally — no key needed, just the base URL
OLLAMA_BASE_URL=http://localhost:11434

# Langfuse observability (OPTIONAL) — traces every model call with latency.
# Leave blank to disable (tracing is a no-op unless BOTH keys are set).
# Get keys from https://cloud.langfuse.com or your self-hosted instance.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
