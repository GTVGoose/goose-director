# --- dependencies & build artifacts (regenerated by npm run build) ---
node_modules/
dist/
dist-app/
*.timestamp-*.mjs

# --- secrets & local env (real keys/tokens live here, never commit) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- runtime / local state ---
threads/
*.log

# --- OS cruft ---
.DS_Store
